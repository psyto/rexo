{
  "name": "context-capital",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Verifiable execution-history credential layer (working name TBD). Phase-0 Receipt generator slice.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:receipt": "tsx src/cli.ts build",
    "preview": "tsx src/cli.ts build --local-preview",
    "profile": "tsx src/cli.ts profile",
    "verify:receipt": "tsx src/cli.ts verify",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "onchain:test": "cd onchain && forge test -vv"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
